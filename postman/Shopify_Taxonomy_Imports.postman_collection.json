    {
      "name": "TC_IMP_005 - Retrieve Import Job by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Import details verified', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.success).to.be.true;",
              "    pm.expect(json.data.id).to.eql(pm.environment.get('import_id'));",
              "    pm.expect(json.data).to.have.property('status');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/imports/{{import_id}}/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "imports", "{{import_id}}", ""]
        }
      }
    },
