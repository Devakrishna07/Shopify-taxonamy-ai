              "});",
              "pm.test('Error envelope details', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.success).to.be.false;",
              "    pm.expect(json.statusCode).to.eql(400);",
              "    pm.expect(json.message).to.eql('No file uploaded.');",
              "    pm.expect(json.data.expected_field).to.eql('file');",
              "});"
            ]
          }
        }
