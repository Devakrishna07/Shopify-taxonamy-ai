{
  "info": {
    "name": "Shopify Taxonomy AI - Imports API Collection",
    "_postman_id": "c1f73b64-16b7-4e48-8df0-7d31215ab70b",
    "description": "Comprehensive automated test suite for Imports API endpoints following industrial standards.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC_IMP_001 - Upload Valid XLSX",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 202 Accepted', function () {",
              "    pm.response.to.have.status(202);",
              "});",
              "pm.test('Response envelope conforms to schema', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.success).to.be.true;",
              "    pm.expect(json.statusCode).to.eql(202);",
              "    pm.expect(json.data).to.have.property('id');",
              "    pm.expect(json.meta).to.have.property('requestId');",
              "    pm.expect(json.meta).to.have.property('timestamp');",
              "    pm.environment.set('import_id', json.data.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "Backend/test_samples/products_valid.xlsx"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/imports/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "imports", ""]
        }
      }
    },
